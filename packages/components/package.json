{
  "name": "@esri/calcite-components",
  "version": "5.2.0-next.25",
  "description": "Web Components for Esri's Calcite Design System.",
  "homepage": "https://developers.arcgis.com/calcite-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esri/calcite-design-system.git",
    "directory": "packages/components"
  },
  "license": "SEE LICENSE.md",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./loader": "./dist/loader.js",
    "./package.json": "./package.json",
    "./components/*/customElement": "./dist/components/*/customElement.js",
    "./components/*": "./dist/components/*/index.js",
    "./types/*": "./dist/types/*.d.ts",
    "./docs/*": "./dist/docs/*",
    "./dist/loader": "./dist/loader.js",
    "./dist/components": "./dist/index.js",
    "./dist/components/*": "./dist/components/*/index.js",
    "./main.css": "./dist/cdn/main.css"
  },
  "main": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "unpkg": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "pnpm util:prep-build-reqs && vite build",
    "postbuild": "pnpm util:generate-t9n-docs-json && pnpm util:generate-supported-browsers-json",
    "build-storybook": "pnpm util:prep-build-reqs && NODE_OPTIONS=--openssl-legacy-provider storybook build --output-dir ./docs --quiet",
    "build:dev": "vite build --mode development",
    "build:watch": "pnpm util:prep-build-reqs && vite --mode production",
    "build:watch-dev": "pnpm util:prep-build-reqs && vite --mode development",
    "clean": "pnpm util:clean-js-files && rimraf node_modules dist docs .turbo",
    "lint": "concurrently pnpm lint:*",
    "lint:html": "prettier --ignore-path \"../../.prettierignore\" --write \"**/*.html\" >/dev/null",
    "lint:json": "prettier --ignore-path \"../../.prettierignore\" --write \"**/*.json\" >/dev/null",
    "lint:md": "prettier --ignore-path \"../../.prettierignore\" --write \"**/*.md\" >/dev/null && markdownlint-cli2 \"**/*.md\" --fix --config \"../../.markdownlint-cli2.jsonc\"",
    "lint:scss": "stylelint --fix \"src/**/*.scss\" && prettier --ignore-path \"../../.prettierignore\" --write \"**/*.scss\" >/dev/null",
    "lint:ts": "eslint --fix && prettier --ignore-path \"../../.prettierignore\" --write \"**/*.{ts,tsx,cjs,mjs}\" >/dev/null",
    "screenshot-tests": "pnpm build-storybook",
    "screenshot-tests:preview": "pnpm util:prep-build-reqs && NODE_OPTIONS=--openssl-legacy-provider STORYBOOK_SCREENSHOT_LOCAL_BUILD=true storybook dev",
    "screenshot-tests:publish": "pnpm screenshot-tests && storybook-to-ghpages --existing-output-dir=docs",
    "start": "pnpm util:clean-js-files && concurrently --kill-others --raw \"trap 'pnpm util:clean-js-files' INT TERM EXIT >/dev/null 2>&1 || true && tsc --project ./tsconfig.demos.json --watch\" \"pnpm build:watch-dev\"",
    "test": "concurrently --passthrough-arguments \"pnpm test:node -- {@}\" \"pnpm test:browser -- {@}\" --",
    "test:ci": "concurrently --passthrough-arguments --names node,browser,time-zone \"pnpm test:node 2>test-node.err.log\" \"pnpm test:browser 2>test-browser.err.log\" \"pnpm test:browser:time-zone 2>test-time-zone.err.log\" || node support/log-test-output.ts",
    "test:node": "vitest run",
    "test:browser": "pnpm util:install-playwright && BROWSER_TESTS=true vitest run",
    "test:browser:time-zone": "pnpm util:install-playwright && node support/run-time-zone-browser-tests.ts run",
    "test:watch": "concurrently --passthrough-arguments \"pnpm test:watch:node -- {@}\" \"pnpm test:watch:browser -- {@}\" --",
    "test:watch:node": "vitest watch",
    "test:watch:browser": "pnpm util:install-playwright && BROWSER_TESTS=true vitest watch",
    "test:watch:browser:time-zone": "pnpm util:install-playwright && node support/run-time-zone-browser-tests.ts watch",
    "util:add-internal-custom-css-prop-doc": "node support/add-internal-custom-prop-doc.ts",
    "util:clean-js-files": "rimraf --glob -- *.js {src,.storybook,support}/**/*.js",
    "util:install-playwright": "node support/install-playwright.ts",
    "util:clean-tested-build": "pnpm install --frozen-lockfile && pnpm test && pnpm build",
    "util:copy-assets": "pnpm util:copy-icons",
    "util:copy-icons": "cpy \"../ui-icons/js/*.json\" \"src/components/icon/assets/\" --flat",
    "util:generate-t9n-docs-json": "node support/generate-t9n-docs-json.ts",
    "util:generate-supported-browsers-json": "node support/generate-supported-browsers-json.ts",
    "util:is-working-tree-clean": "[ -z \"$(git status --porcelain=v1)\" ]",
    "util:prep-build-reqs": "pnpm util:copy-assets",
    "util:sync-t9n-en-bundles": "node support/sync-en-t9n-bundles.ts",
    "util:update-3rd-party-notices": "node ../../support/createThirdPartyNotices.mts"
  },
  "dependencies": {
    "@arcgis/lumina": ">=5.1.0-next.96 <6.0.0",
    "@arcgis/toolkit": ">=5.1.0-next.96 <6.0.0",
    "@esri/calcite-ui-icons": "4.6.0-next.7",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.8",
    "@types/sortablejs": "^1.15.8",
    "color": "^5.0.3",
    "composed-offset-position": "^0.0.6",
    "es-toolkit": "^1.39.8",
    "focus-trap": "^8.2.1",
    "interactjs": "^1.10.27",
    "lit": "^3.3.0",
    "sortablejs": "^1.15.6",
    "tabbable": "^6.2.0",
    "timezone-groups": "^0.10.4",
    "type-fest": "^4.30.1"
  },
  "devDependencies": {
    "@arcgis/api-extractor": ">=5.1.0-next.96 <6.0.0",
    "@arcgis/lumina-compiler": ">=5.1.0-next.96 <6.0.0",
    "@esri/calcite-design-tokens": "4.1.1-next.3",
    "@esri/calcite-tailwind-preset": "1.1.2-next.3",
    "@esri/eslint-plugin-calcite-components": "2.0.4-next.20",
    "@esri/stylelint-plugin-calcite-components": "0.2.0-next.1",
    "playwright": "1.61.1",
    "sass-embedded": "1.100.0",
    "vitest": "4.1.10"
  },
  "css.customData": [
    "dist/docs/vscode.css-custom-data.json"
  ],
  "customElements": "dist/docs/api.json",
  "html.customData": [
    "dist/docs/vscode.html-custom-data.json"
  ],
  "web-types": "dist/docs/web-types.json"
}
