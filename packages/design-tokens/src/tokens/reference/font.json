{
  "reference": {
    "font": {
      "weight": {
        "regular": {
          "attributes": {
            "category": "font",
            "group": "weight"
          },
          "$type": "fontWeights",
          "$value": "{font.weight.normal}"
        }
      },
      "size": {
        "2xl": {
          "attributes": {
            "category": "font",
            "group": "size"
          },
          "$type": "fontSizes",
          "$value": "{font.size.xxl}"
        }
      }
    }
  }
}
