    "height": {
      "xxs": {
        "min": {
          "attributes": {
            "category": "breakpoint",
            "docs": "deprecated"
          },
          "$type": "dimension",
          "$value": "{core.container-size.0}",
          "$description": "Deprecated in v4.0.0, removal target v5.0.0 - Use `--calcite-container-size-height-2xs-min|max` instead."
        },
        "max": {
          "attributes": {
            "category": "breakpoint",
            "docs": "deprecated"
          },
