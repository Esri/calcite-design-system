{
  "container-size": {
    "height": {
      "xxs": {
        "$value": {
          "min": "0",
          "max": "{core.container-size.154}"
        },
        "$description": "Deprecated in v4.0.0, removal target v5.0.0 - Use `--calcite-container-size-height-2xs-min|max` instead.",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint",
          "docs": "deprecated"
        }
      },
      "2xs": {
        "$value": {
          "min": "0",
          "max": "{core.container-size.154}"
        },
        "$description": "Small handheld devices and mini-windows",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "xs": {
        "$value": {
          "min": "{core.container-size.154} + 1",
          "max": "{core.container-size.328}"
        },
        "$description": "Handheld devices",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "sm": {
        "$value": {
          "min": "{core.container-size.328} + 1",
          "max": "{core.container-size.504}"
        },
        "$description": "Small tablets",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "md": {
        "$value": {
          "min": "{core.container-size.504} + 1",
          "max": "{core.container-size.678}"
        },
        "$description": "Small laptops",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "lg": {
        "$value": {
          "min": "{core.container-size.678} + 1",
          "max": "{core.container-size.854}"
        },
        "$description": "Large laptops and desktop computers",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "xl": {
        "$value": {
          "min": "{core.container-size.854} + 1"
        },
        "$description": "Projectors and televisions",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      }
    },
    "width": {
      "xxs": {
        "$value": {
          "min": "0",
          "max": "{core.container-size.320}"
        },
        "$description": "Deprecated in v4.0.0, removal target v5.0.0 - Use `--calcite-container-size-width-2xs-min|max` instead.",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint",
          "docs": "deprecated"
        }
      },
      "2xs": {
        "$value": {
          "min": "0",
          "max": "{core.container-size.320}"
        },
        "$description": "Small handheld devices and mini-windows",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "xs": {
        "$value": {
          "min": "{core.container-size.320} + 1",
          "max": "{core.container-size.476}"
        },
        "$description": "Handheld devices",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "sm": {
        "$value": {
          "min": "{core.container-size.476} + 1",
          "max": "{core.container-size.768}"
        },
        "$description": "Small tablets",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "md": {
        "$value": {
          "min": "{core.container-size.768} + 1",
          "max": "{core.container-size.1152}"
        },
        "$description": "Small laptops",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "lg": {
        "$value": {
          "min": "{core.container-size.1152} + 1",
          "max": "{core.container-size.1440}"
        },
        "$description": "Large laptops and desktop computers",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "xl": {
        "$value": {
          "min": "{core.container-size.1440} + 1"
        },
        "$description": "Projectors and televisions",
        "$type": "dimension",
        "attributes": {
          "category": "breakpoint"
        }
      }
    },
    "margin": {
      "$value": "{core.size.default.24}",
      "$type": "spacing",
      "attributes": {
        "category": "breakpoint"
      }
    },
    "gutter": {
      "$value": "{core.size.default.16}",
      "$type": "spacing",
      "attributes": {
        "category": "breakpoint"
      }
    },
    "content": {
      "fluid": {
        "$value": "{core.size.relative.100}",
        "$description": "for fluid grid widths",
        "$type": "sizing",
        "attributes": {
          "category": "breakpoint"
        }
      },
      "fixed": {
        "$value": "{core.container-size.1440}",
        "$description": "only for lg breakpoint fixed grid width",
        "$type": "sizing",
        "attributes": {
          "category": "breakpoint"
        }
      }
    }
  }
}
