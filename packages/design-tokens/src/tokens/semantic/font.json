{
  "font": {
    "family": {
      "default": {
        "attributes": {
          "category": "font",
          "group": "family"
        },
        "$type": "fontFamilies",
        "$value": "{core.font.family.avenirNext},{core.font.family.avenir},{core.font.family.helveticaNeue},{core.font.family.sansSerif}",
        "$description": "Primary font with fallbacks"
      },
      "code": {
        "attributes": {
          "category": "font",
          "group": "family"
        },
        "$type": "fontFamilies",
        "$value": "{core.font.family.monaco},{core.font.family.consolas},{core.font.family.andaleMono},{core.font.family.lucidaConsole},{core.font.family.monospace}",
        "$description": "Font family for code with fallbacks"
      }
    },
    "weight": {
      "light": {
        "attributes": {
          "category": "font",
          "group": "weight"
        },
        "$extensions": {
          "calcite.theme": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.light}",
        "$description": "For Avenir Next World (secondary font family)"
      },
      "normal": {
        "attributes": {
          "category": "font",
          "group": "weight",
          "docs": "deprecated"
        },
        "extensions": {
          "calcite.deprecated": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.regular}",
        "$description": "Deprecated in v3.0.0, removal target v6.0.0 - Use `--calcite-font-weight-regular` instead."
      },
      "regular": {
        "attributes": {
          "category": "font",
          "group": "weight"
        },
        "$extensions": {
          "calcite.theme": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.regular}",
        "$description": "Replaces `--calcite-font-weight-normal`"
      },
      "medium": {
        "attributes": {
          "category": "font",
          "group": "weight"
        },
        "$extensions": {
          "calcite.theme": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.medium}"
      },
      "semibold": {
        "attributes": {
          "category": "font",
          "group": "weight"
        },
        "$extensions": {
          "calcite.theme": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.demi}"
      },
      "bold": {
        "attributes": {
          "category": "font",
          "group": "weight"
        },
        "$extensions": {
          "calcite.theme": true
        },
        "$type": "fontWeights",
        "$value": "{core.font.weight.demi}"
      }
    },
