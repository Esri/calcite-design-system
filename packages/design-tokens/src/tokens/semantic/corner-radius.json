{
  "corner-radius": {
    "default": {
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.theme": true
      },
      "$type": "borderRadius",
      "$value": "{corner-radius.none}"
    },
    "sharp": {
      "attributes": {
        "category": "corner-radius",
        "docs": "deprecated"
      },
      "$type": "borderRadius",
      "$value": "{core.size.default.none}",
      "$description": "Deprecated in v3.1.0, removal target v6.0.0 - Use `--calcite-theme-corner-radius-none` instead."
    },
    "none": {
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.theme": true
      },
      "$type": "borderRadius",
      "$value": "{corner-radius.sharp}",
      "$description": "Replaces `--calcite-corner-radius-sharp`"
    },
    "xs": {
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.theme": true
      },
      "$type": "borderRadius",
      "$value": "{core.size.default.2}"
    },
    "sm": {
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.theme": true
      },
      "$type": "borderRadius",
      "$value": "{corner-radius.round}",
      "$description": "Replaces `--calcite-corner-radius-round`"
    },
    "round": {
      "attributes": {
        "category": "corner-radius",
        "docs": "deprecated"
      },
      "$type": "borderRadius",
      "$value": "{core.size.default.4}",
      "$description": "Deprecated in v3.1.0, removal target v6.0.0 - Use `--calcite-theme-corner-radius-sm` instead."
    },
    "pill": {
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.theme": true
      },
      "$type": "borderRadius",
      "$value": "{core.size.default.9999}"
    }
  }
}