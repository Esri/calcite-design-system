{
  "corner-radius": {
    "default": {
      "$value": "{corner-radius.none}",
      "$type": "borderRadius",
      "$extensions": {
        "calcite.outputReference": true
      },
      "attributes": {
        "category": "corner-radius"
      }
    },
    "sharp": {
      "$value": "{core.size.default.none}",
      "$description": "Deprecated in v3.1.0, removal target v5.0.0 - Use `--calcite-corner-radius-none` instead.",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius",
        "docs": "deprecated"
      }
    },
    "none": {
      "$value": "{corner-radius.sharp}",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.outputReference": true
      },
      "$description": "Replaces `--calcite-corner-radius-sharp`"
    },
    "xs": {
      "$value": "{core.size.default.2}",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius"
      }
    },
    "sm": {
      "$value": "{corner-radius.round}",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius"
      },
      "$extensions": {
        "calcite.outputReference": true
      },
      "$description": "Replaces `--calcite-corner-radius-round`"
    },
    "round": {
      "$value": "{core.size.default.4}",
      "$description": "Deprecated in v3.1.0, removal target v5.0.0 - Use `--calcite-corner-radius-sm` instead.",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius",
        "docs": "deprecated"
      }
    },
    "pill": {
      "$value": "{core.size.default.9999}",
      "$type": "borderRadius",
      "attributes": {
        "category": "corner-radius"
      }
    }
  }
}
