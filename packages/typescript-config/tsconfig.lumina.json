{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "es2025",
      "esnext.array",
      "esnext.disposable",
      "esnext.error",
