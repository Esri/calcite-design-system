{
  "name": "@esri/calcite-tailwind-preset",
  "version": "1.1.2-next.11",
  "description": "Tailwind CSS preset for the Calcite Design System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esri/calcite-design-system.git",
    "directory": "packages/tailwind-preset"
  },
  "license": "SEE LICENSE.md",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist node_modules .turbo",
    "lint": "concurrently npm:lint:*",
    "lint:json": "prettier --ignore-path \"../../.prettierignore\" --write \"**/*.json\" >/dev/null",
    "lint:md": "prettier --ignore-path \"../../.prettierignore\" --write \"**/*.md\" >/dev/null && markdownlint-cli2 \"**/*.md\" --fix --config \"../../.markdownlint-cli2.jsonc\"",
    "util:update-3rd-party-notices": "node ../../support/createThirdPartyNotices.mts"
  },
  "dependencies": {
    "@esri/calcite-design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "@esri/calcite-design-tokens": "workspace:*",
    "tailwindcss": "^3.0.0 < 5.0.0"
  },
  "devDependencies": {
    "@esri/calcite-typescript-config": "workspace:*",
    "@esri/eslint-config-calcite": "workspace:*",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
